<Window x:Class="CGMCollage.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF" Title="CGM Collage" Width="1600" Height="960" MinWidth="1200" MinHeight="720" Icon="Assets/app.ico" AllowDrop="True">
 <Grid><Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="{StaticResource TopBrush}" BorderBrush="#272C35" BorderThickness="0,0,0,1"><Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid Width="29" Height="34" Margin="0,0,10,0"><Border Background="#F51B57" Width="6" Height="30" CornerRadius="2" HorizontalAlignment="Left" RenderTransformOrigin=".5,.5"><Border.RenderTransform><SkewTransform AngleX="-8"/></Border.RenderTransform></Border><Border Background="#D8194D" Width="6" Height="30" CornerRadius="2" HorizontalAlignment="Center"/><Border Background="#A5123B" Width="6" Height="30" CornerRadius="2" HorizontalAlignment="Right" RenderTransformOrigin=".5,.5"><Border.RenderTransform><SkewTransform AngleX="-8"/></Border.RenderTransform></Border></Grid><StackPanel Width="185"><StackPanel Orientation="Horizontal"><TextBlock Text="CGM Collage" FontWeight="SemiBold" FontSize="15"/><Border Background="#65142E" CornerRadius="8" Padding="6,1" Margin="8,0,0,0"><TextBlock Text="3.0.1" FontSize="10"/></Border></StackPanel><TextBlock x:Name="ProjectStatus" Text="Untitled project" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button Content="New" Click="New_Click"/><Button Content="Open" Click="Open_Click" Margin="7,0"/><Button Content="Save" Click="Save_Click"/><Button x:Name="UndoButton" Content="Undo" Click="Undo_Click" Margin="18,0,7,0"/><Button x:Name="RedoButton" Content="Redo" Click="Redo_Click"/></StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><StackPanel Width="220"><TextBlock Text="OUTPUT SIZE" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="SemiBold" Margin="2,0,0,3"/><ComboBox x:Name="CanvasPreset" Width="220" SelectionChanged="CanvasPreset_Changed"><ComboBoxItem Content="Article Header · 1200 × 675" Tag="1200,675" IsSelected="True"/><ComboBoxItem Content="HD Header · 1280 × 720" Tag="1280,720"/><ComboBoxItem Content="Full HD · 1920 × 1080" Tag="1920,1080"/><ComboBoxItem Content="Square · 1200 × 1200" Tag="1200,1200"/><ComboBoxItem Content="Social Portrait · 1080 × 1350" Tag="1080,1350"/></ComboBox></StackPanel><Button Content="Quick JPG" Click="QuickExport_Click" Margin="8,13,8,0"/><Button Content="Export…" Style="{StaticResource PrimaryButton}" Click="Export_Click" Margin="0,13,0,0"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="264"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource PanelBrush}" BorderBrush="#272C35" BorderThickness="0,0,1,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="15,15,12,18"><TextBlock Text="LAYOUTS" Style="{StaticResource SectionLabel}"/><ItemsControl x:Name="TemplateList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><Separator Margin="0,18" Background="#303642"/><TextBlock Text="CANVAS" Style="{StaticResource SectionLabel}"/><TextBlock Text="Panel gap" Foreground="{StaticResource MutedBrush}"/><Slider x:Name="GapSlider" Minimum="0" Maximum="80" ValueChanged="Gap_Changed"/><TextBlock x:Name="GapValue" Text="0 px" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/><CheckBox x:Name="GuidesToggle" Content="Show safe area" Checked="CanvasOption_Changed" Unchecked="CanvasOption_Changed"/><Button Content="Add images…" Click="AddImages_Click" Margin="0,12,0,0"/><TextBlock Text="Drop onto a panel to place the image there. Multiple files continue into the next empty panels." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="18"/></StackPanel></ScrollViewer></Border>
   <Grid Grid.Column="1" Background="#0B0E12"><Border Margin="28" Background="#11151A" BorderBrush="#252B34" BorderThickness="1" CornerRadius="4"><Viewbox Stretch="Uniform" Margin="22"><Border Width="1200" Height="675" Background="#101216"><skia:SKElement x:Name="Canvas" PaintSurface="Canvas_PaintSurface" MouseDown="Canvas_MouseDown" MouseMove="Canvas_MouseMove" MouseUp="Canvas_MouseUp" MouseWheel="Canvas_MouseWheel" DragEnter="Canvas_DragEnter" DragOver="Canvas_DragOver" DragLeave="Canvas_DragLeave" Drop="Canvas_Drop" AllowDrop="True"/></Border></Viewbox></Border></Grid>
   <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="#272C35" BorderThickness="1,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="17"><DockPanel><TextBlock Text="SELECTED PANEL" Style="{StaticResource SectionLabel}"/><Border x:Name="PanelBadge" Background="#65142E" CornerRadius="10" Padding="7,2" HorizontalAlignment="Right"><TextBlock x:Name="PanelNumber" Text="1" FontSize="10"/></Border></DockPanel><Border Height="88" Background="#0E1115" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,10"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ImageName" Text="Drop or choose an image" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><Button Content="Choose image…" Click="Replace_Click" Margin="40,9,40,0" Padding="7,3" MinHeight="27"/></StackPanel></Border><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Remove" Click="Remove_Click" Margin="0,0,4,0"/><Button Grid.Column="1" x:Name="FitButton" Content="Fill frame" Click="Fit_Click" Margin="4,0,0,0"/></Grid>
    <Separator Margin="0,18" Background="#303642"/><TextBlock Text="CROP &amp; POSITION" Style="{StaticResource SectionLabel}"/><TextBlock Text="Zoom" Foreground="{StaticResource MutedBrush}"/><Slider x:Name="ZoomSlider" Minimum="1" Maximum="4" Value="1" ValueChanged="PropertySlider_Changed"/><TextBlock Text="Horizontal position" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"/><Slider x:Name="CropXSlider" Minimum="-1" Maximum="1" ValueChanged="PropertySlider_Changed"/><TextBlock Text="Vertical position" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"/><Slider x:Name="CropYSlider" Minimum="-1" Maximum="1" ValueChanged="PropertySlider_Changed"/><TextBlock Text="Rotation" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"/><Slider x:Name="RotationSlider" Minimum="-180" Maximum="180" ValueChanged="PropertySlider_Changed"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Centre" Click="Centre_Click" Margin="0,0,4,0"/><Button Grid.Column="1" Content="Reset crop" Click="ResetCrop_Click" Margin="4,0,0,0"/></Grid><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="FlipXButton" Content="Flip horizontal" Click="FlipX_Click" Margin="0,0,4,0"/><Button Grid.Column="1" x:Name="FlipYButton" Content="Flip vertical" Click="FlipY_Click" Margin="4,0,0,0"/></Grid>
    <Separator Margin="0,18" Background="#303642"/><TextBlock Text="IMAGE ADJUSTMENTS" Style="{StaticResource SectionLabel}"/><TextBlock Text="Brightness" Foreground="{StaticResource MutedBrush}"/><Slider x:Name="BrightnessSlider" Minimum="-1" Maximum="1" ValueChanged="PropertySlider_Changed"/><TextBlock Text="Contrast" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"/><Slider x:Name="ContrastSlider" Minimum="0" Maximum="2" Value="1" ValueChanged="PropertySlider_Changed"/><TextBlock Text="Saturation" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"/><Slider x:Name="SaturationSlider" Minimum="0" Maximum="2" Value="1" ValueChanged="PropertySlider_Changed"/><TextBlock Text="Opacity" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"/><Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" Value="1" ValueChanged="PropertySlider_Changed"/>
    <Separator Margin="0,18" Background="#303642"/><TextBlock Text="FRAME" Style="{StaticResource SectionLabel}"/><TextBlock Text="Border width" Foreground="{StaticResource MutedBrush}"/><Slider x:Name="BorderSlider" Minimum="0" Maximum="30" ValueChanged="PropertySlider_Changed"/><CheckBox x:Name="ShadowToggle" Content="Soft shadow" Checked="FrameOption_Changed" Unchecked="FrameOption_Changed"/><Button Content="Duplicate panel" Click="Duplicate_Click" Margin="0,9,0,0"/></StackPanel></ScrollViewer></Border>
  </Grid>
  <Border Grid.Row="2" Background="{StaticResource TopBrush}" BorderBrush="#272C35" BorderThickness="0,1,0,0"><DockPanel Margin="15,0"><TextBlock x:Name="StatusText" Text="Ready · Drop images to begin" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><TextBlock DockPanel.Dock="Right" Text="Wheel zooms · Drag repositions · Delete clears · Ctrl+Z undo" VerticalAlignment="Center" Foreground="#767F8E" FontSize="11"/></DockPanel></Border>
 </Grid>
</Window>
